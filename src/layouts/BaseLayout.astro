---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Boy Jiang — Notes, projects and thoughts",
  description = '记录学习、项目与日常思考的个人网站。',
} = Astro.props;
const pathname = Astro.url.pathname;
const nav = [
  { href: '/blog/', label: '博客' },
  { href: '/projects/', label: '项目' },
  { href: '/notes/', label: '笔记' },
  { href: '/about/', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfcfa" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="flow-ribbon" aria-hidden="true"></div>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="返回首页">
        <span class="wordmark-dot"></span>
        <span>Boy Jiang</span>
      </a>
      <nav aria-label="主导航">
        {nav.map((item) => (
          <a class:list={[pathname.startsWith(item.href) && 'active']} href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer shell">
      <span>© 2026 Boy Jiang</span>
      <span>用 Markdown 写作 · 用 Astro 构建</span>
      <a href="https://github.com/BoyJiang2" rel="noreferrer">GitHub ↗</a>
    </footer>
  </body>
</html>
