---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Boy Jiang — Notes, projects and thoughts",
  description = '记录学习、项目与日常思考的个人网站。',
} = Astro.props;
const pathname = Astro.url.pathname;
const primaryNav = [
  { href: '/blog/', label: '博客', icon: '✦' },
  { href: '/projects/', label: '项目', icon: '◇' },
  { href: '/notes/', label: '笔记', icon: '☘' },
  { href: '/search/', label: '搜索', icon: '⌕' },
];
const themes = [
  { value: 'midnight-gold', label: 'Midnight Gold', note: '午夜金' },
  { value: 'professional-dark', label: 'Professional Dark', note: '专业深色' },
  { value: 'glassmorphism-light', label: 'Glassmorphism Light', note: '玻璃浅色' },
  { value: 'dark-neon', label: 'Dark Neon', note: '暗色霓虹' },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="midnight-gold">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfcfa" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('boy-jiang-theme');
        const allowed = ['midnight-gold', 'professional-dark', 'glassmorphism-light', 'dark-neon'];
        if (saved && allowed.includes(saved)) document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <div class="flow-ribbon" aria-hidden="true"></div>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="返回首页">Boy Jiang</a>
      <nav aria-label="主导航">
        {primaryNav.map((item) => (
          <a class:list={[pathname.startsWith(item.href) && 'active']} href={item.href}><span aria-hidden="true">{item.icon}</span><span class="nav-label">{item.label}</span></a>
        ))}
        <details class="theme-picker">
          <summary><span aria-hidden="true">◐</span><span class="nav-label">主题</span></summary>
          <div class="theme-panel">
            <p>选择阅读氛围</p>
            {themes.map((theme) => (
              <button type="button" data-theme-value={theme.value}>
                <span class={`theme-swatch ${theme.value}`} aria-hidden="true"></span>
                <span><strong>{theme.label}</strong><small>{theme.note}</small></span>
                <span class="theme-check" aria-hidden="true">✓</span>
              </button>
            ))}
          </div>
        </details>
        <a class:list={[pathname.startsWith('/about/') && 'active']} href="/about/"><span aria-hidden="true">☻</span><span class="nav-label">关于</span></a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer shell">
      <span>© 2026 Boy Jiang</span>
      <span>用 Markdown 写作 · 用 Astro 构建</span>
      <a href="https://github.com/BoyJiang2" rel="noreferrer">GitHub ↗</a>
    </footer>
    <script is:inline>
      const themePicker = document.querySelector('.theme-picker');
      const themeButtons = [...document.querySelectorAll('[data-theme-value]')];
      const setTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        themeButtons.forEach((button) => button.classList.toggle('selected', button.dataset.themeValue === theme));
        try { localStorage.setItem('boy-jiang-theme', theme); } catch {}
      };
      setTheme(document.documentElement.dataset.theme || 'midnight-gold');
      themeButtons.forEach((button) => button.addEventListener('click', () => {
        setTheme(button.dataset.themeValue);
        themePicker?.removeAttribute('open');
      }));
      document.addEventListener('click', (event) => {
        if (themePicker?.open && !themePicker.contains(event.target)) themePicker.removeAttribute('open');
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') themePicker?.removeAttribute('open');
      });
    </script>
  </body>
</html>
