---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Boy Jiang — Notes, projects and thoughts",
  description = '记录学习、项目与日常思考的个人网站。',
} = Astro.props;
const pathname = Astro.url.pathname;
const nav = [
  { href: '/blog/', label: '博客', icon: '✦' },
  { href: '/projects/', label: '项目', icon: '◇' },
  { href: '/notes/', label: '笔记', icon: '☘' },
  { href: '/about/', label: '关于', icon: '☻' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfcfa" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="flow-ribbon" aria-hidden="true"></div>
    <header class="site-header shell">
      <div class="header-start">
        <details class="quick-index">
          <summary><span aria-hidden="true">⌘</span><span>索引</span></summary>
          <div class="quick-index-panel">
            <p>去哪里看看？</p>
            <a href="/"><span>⌂</span><span><strong>首页</strong><small>从这里重新出发</small></span></a>
            {nav.map((item) => (
              <a href={item.href}><span>{item.icon}</span><span><strong>{item.label}</strong><small>{item.label === '博客' ? '所思所想' : item.label === '项目' ? '正在创造' : item.label === '笔记' ? '课程与论文' : '关于我'}</small></span></a>
            ))}
          </div>
        </details>
        <a class="wordmark" href="/" aria-label="返回首页">
          <span class="wordmark-dot"></span>
          <span>Boy Jiang</span>
        </a>
      </div>
      <nav aria-label="主导航">
        {nav.map((item) => (
          <a class:list={[pathname.startsWith(item.href) && 'active']} href={item.href}><span aria-hidden="true">{item.icon}</span>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer shell">
      <span>© 2026 Boy Jiang</span>
      <span>用 Markdown 写作 · 用 Astro 构建</span>
      <a href="https://github.com/BoyJiang2" rel="noreferrer">GitHub ↗</a>
    </footer>
    <script is:inline>
      const quickIndex = document.querySelector('.quick-index');
      document.addEventListener('click', (event) => {
        if (quickIndex?.open && !quickIndex.contains(event.target)) quickIndex.removeAttribute('open');
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') quickIndex?.removeAttribute('open');
      });
    </script>
  </body>
</html>
