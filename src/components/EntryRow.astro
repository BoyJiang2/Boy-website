---
interface Props {
  href: string;
  eyebrow?: string;
  title: string;
  summary: string;
  tags?: string[];
}

const { href, eyebrow, title, summary, tags = [] } = Astro.props;
const hasMeta = Boolean(eyebrow);
---

<article class:list={['entry-row', !hasMeta && 'compact']}>
  {hasMeta && <div class="entry-meta">
    {eyebrow && <span>{eyebrow}</span>}
  </div>}
  <div class="entry-body">
    <h3><a href={href}>{title}</a></h3>
    <p>{summary}</p>
    {tags.length > 0 && <div class="tag-line">{tags.map((tag) => <span>#{tag}</span>)}</div>}
  </div>
  <a class="entry-arrow" href={href} aria-label={`阅读 ${title}`}>↗</a>
</article>
