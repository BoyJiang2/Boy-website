---
interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      summary: string;
      tags: string[];
      github: string;
    };
  };
  index?: number;
}
const { entry, index = 0 } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const ariaLabel = `在新标签页打开 ${entry.data.title} 的 GitHub`;
---

<article class="project-source-item">
  <a class="project-source-card" href={entry.data.github} target="_blank" rel="noreferrer" aria-label={ariaLabel}>
    <span class="project-source-number" aria-hidden="true">{number}</span>
    <div class="project-source-content">
      <h3>{entry.data.title}</h3>
      <p class="project-source-summary">{entry.data.summary}</p>
      {entry.data.tags.length > 0 && <div class="project-source-tags" aria-label="技术标签">{entry.data.tags.map((tag) => <span>{tag}</span>)}</div>}
    </div>
    <span class="project-source-link">GitHub <span aria-hidden="true">↗</span></span>
  </a>
</article>

<style>
  .project-source-item {
    min-width: 0;
  }

  .project-source-card {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) max-content;
    gap: 20px;
    align-items: start;
    padding: 26px 28px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    color: inherit;
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }

  .project-source-card:hover,
  .project-source-card:focus-visible {
    border-color: var(--accent);
    box-shadow: var(--shadow);
    outline: none;
    transform: translateY(-3px);
  }

  .project-source-number {
    color: var(--accent);
    font: 500 clamp(2.2rem, 3.6vw, 3.2rem)/.9 var(--serif);
    letter-spacing: -.08em;
  }

  .project-source-content {
    min-width: 0;
  }

  .project-source-card h3 {
    margin: 0;
    color: var(--ink);
    font: 500 clamp(1.55rem, 2.2vw, 2rem)/1.12 var(--serif);
    letter-spacing: -.04em;
  }

  .project-source-summary {
    max-width: 620px;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: .91rem;
  }

  .project-source-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
  }

  .project-source-tags span {
    padding: 4px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: .68rem;
  }

  .project-source-link {
    display: inline-flex;
    gap: 7px;
    align-items: center;
    padding-top: 3px;
    color: var(--accent);
    font-size: .76rem;
    font-weight: 720;
    white-space: nowrap;
  }

  .project-source-card:hover .project-source-link span,
  .project-source-card:focus-visible .project-source-link span {
    transform: translate(2px, -2px);
  }

  .project-source-link span {
    transition: transform .2s ease;
  }

  @media (max-width: 680px) {
    .project-source-card {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 16px;
      min-height: 0;
      padding: 24px 22px;
    }

    .project-source-link {
      grid-column: 2;
      grid-row: 2;
      padding-top: 2px;
    }
  }
</style>
