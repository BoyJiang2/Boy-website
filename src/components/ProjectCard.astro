---
interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      summary: string;
      tags: string[];
    };
  };
}
const { entry } = Astro.props;
---

<article class="project-card">
  <h3><a href={`/projects/${entry.id}/`}>{entry.data.title}</a></h3>
  <p>{entry.data.summary}</p>
  <div class="project-tags">{entry.data.tags.map((tag) => <span>{tag}</span>)}</div>
  <div class="project-links">
    <a href={`/projects/${entry.id}/`}>查看项目 →</a>
  </div>
</article>
