---
import ContentTree, { type TreeNode } from './ContentTree.astro';
import OutlineTree, { type OutlineNode } from './OutlineTree.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  collectionLabel: string;
  tree: TreeNode[];
  headings: Heading[];
}

const { collectionLabel, tree, headings } = Astro.props;

const outline: OutlineNode[] = [];
const stack: OutlineNode[] = [];
for (const heading of headings.filter((item) => item.depth >= 1 && item.depth <= 5)) {
  const node: OutlineNode = { ...heading, children: [] };
  while (stack.length && stack.at(-1)!.depth >= node.depth) stack.pop();
  if (stack.length) stack.at(-1)!.children.push(node);
  else outline.push(node);
  stack.push(node);
}
---

<div class="article-index-rail" data-article-index-rail>
  <button
    class="article-index-toggle"
    type="button"
    aria-label="收起目录"
    aria-expanded="true"
    aria-controls="article-index-content"
    data-article-index-toggle
    data-tooltip="收起目录"
  >
    <svg class="article-index-toggle-collapse" viewBox="0 0 24 24" aria-hidden="true"><path d="m13.5 5-7 7 7 7M20 5l-7 7 7 7" /></svg>
    <svg class="article-index-toggle-expand" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h12M4 19h8" /></svg>
  </button>
  <aside id="article-index-content" class="article-index" aria-label="阅读导航" data-article-index>
    <section class="page-outline" aria-label="本篇目录">
      <div class="index-heading small"><span aria-hidden="true">⌁</span><strong>本篇目录</strong></div>
      {outline.length > 0 ? <OutlineTree nodes={outline} /> : <p>这一篇很短，慢慢读就好。</p>}
    </section>
    <details class="all-content-tree">
      <summary>{collectionLabel}</summary>
      <nav aria-label={collectionLabel}><ContentTree nodes={tree} /></nav>
    </details>
  </aside>
</div>

<script>
  const indexCollapseStorageKey = 'boy-jiang-article-index-collapsed-v1';

  const initializeArticleIndexes = () => {
    document.querySelectorAll<HTMLElement>('[data-article-index-rail]').forEach((rail) => {
      if (rail.dataset.scrollLinked) return;
      rail.dataset.scrollLinked = 'true';

      const index = rail.querySelector<HTMLElement>('[data-article-index]');
      const toggle = rail.querySelector<HTMLButtonElement>('[data-article-index-toggle]');
      if (!index || !toggle) return;

      const setCollapsed = (collapsed: boolean) => {
        rail.dataset.collapsed = String(collapsed);
        const label = collapsed ? '展开目录' : '收起目录';
        toggle.setAttribute('aria-label', label);
        toggle.setAttribute('aria-expanded', String(!collapsed));
        toggle.dataset.tooltip = label;
      };

      try { setCollapsed(localStorage.getItem(indexCollapseStorageKey) === 'true'); } catch { setCollapsed(false); }
      toggle.addEventListener('click', () => {
        const collapsed = rail.dataset.collapsed !== 'true';
        setCollapsed(collapsed);
        try { localStorage.setItem(indexCollapseStorageKey, String(collapsed)); } catch {}
      });

      const links = [...index.querySelectorAll<HTMLAnchorElement>('.outline-tree a')];
      const headingElements = links
        .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
        .filter((heading): heading is HTMLElement => Boolean(heading));
      if (!headingElements.length) return;

      const setActive = (id: string) => links.forEach((link) => {
        const isActive = decodeURIComponent(link.hash.slice(1)) === id;
        link.classList.toggle('is-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const syncActiveHeading = () => {
        const marker = window.innerHeight * 0.3;
        const current = headingElements.reduce((active, heading) => (
          heading.getBoundingClientRect().top <= marker ? heading : active
        ), headingElements[0]);
        setActive(current.id);
      };
      const observer = new IntersectionObserver(syncActiveHeading, { rootMargin: '-30% 0px -55% 0px' });
      headingElements.forEach((heading) => observer.observe(heading));
      window.addEventListener('scroll', syncActiveHeading, { passive: true });
      window.addEventListener('resize', syncActiveHeading);
      syncActiveHeading();
    });
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeArticleIndexes);
  else initializeArticleIndexes();
  document.addEventListener('astro:page-load', initializeArticleIndexes);
</script>
