---
import { getCollection } from 'astro:content';
import CourseCard from '../../components/CourseCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="课程笔记 · Notes Atlas">
  <section class="listing-hero">
    <p class="eyebrow">LEARNING PATHS</p>
    <h1>一门课，<em>一条</em>理解的路径。</h1>
    <p>从概念到推导、代码与复盘。每一份笔记都应该留下自己思考过的痕迹。</p>
  </section>
  <div class="course-grid full-grid">
    {courses.map((entry) => <CourseCard entry={entry} />)}
  </div>
</BaseLayout>
