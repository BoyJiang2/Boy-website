---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNoteLocation } from '../../utils/notes';
const entries = (await getCollection('notes')).sort((a, b) => a.id.localeCompare(b.id, 'zh-CN'));
const categories = ['全部', ...new Set(entries.map((entry) => getNoteLocation(entry).category))];
---

<BaseLayout title="笔记 — Boy Jiang" description="课程、论文与技术学习笔记。">
  <header class="page-head shell">
    <p class="page-kicker">Notes</p>
    <h1><span class="page-title-icon" aria-hidden="true">☘</span>笔记</h1>
    <p class="section-description">课程、论文和技术主题都归档在这里，可以按分类筛选。</p>
  </header>
  <section class="content-shell shell">
    <div class="filter-bar">
      {categories.map((category, index) => <button class:list={['filter-button', index === 0 && 'active']} data-filter={category}>{category}</button>)}
    </div>
    <div class="entry-list" id="notes-list">
      {entries.map((entry) => {
        const location = getNoteLocation(entry);
        return (
          <article class="entry-row note-filter-item" data-category={location.category}>
            <div class="entry-meta"><span>{location.category}</span><small>{location.series}</small></div>
            <div class="entry-body"><h3><a href={`/notes/${location.slug}/`}>{entry.data.title}</a></h3><p>{entry.data.summary}</p><div class="tag-line">{entry.data.tags.map((tag) => <span>#{tag}</span>)}</div></div>
            <a class="entry-arrow" href={`/notes/${location.slug}/`} aria-label={`阅读 ${entry.data.title}`}>↗</a>
          </article>
        );
      })}
    </div>
  </section>
  <script is:inline>
    const buttons = [...document.querySelectorAll('[data-filter]')];
    const items = [...document.querySelectorAll('.note-filter-item')];
    let activeType = '全部';
    const update = () => {
      items.forEach((item) => {
        const matchesType = activeType === '全部' || item.dataset.category === activeType;
        item.hidden = !matchesType;
      });
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      activeType = button.dataset.filter;
      buttons.forEach((candidate) => candidate.classList.toggle('active', candidate === button));
      update();
    }));
  </script>
</BaseLayout>
