---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const blogs = await getCollection('blog', ({ data }) => !data.draft);
const projects = await getCollection('projects', ({ data }) => !data.draft);
const notes = await getCollection('notes', ({ data }) => !data.draft);

const items = [
  ...blogs.map((entry) => ({
    title: entry.data.title,
    summary: entry.data.summary,
    href: `/blog/${entry.id}/`,
    kind: '博客',
    icon: '✦',
    detail: '',
    date: entry.data.updated ?? entry.data.published,
    search: [entry.data.title, entry.data.summary, ...entry.data.tags, entry.body].join(' ').toLowerCase(),
  })),
  ...projects.map((entry) => ({
    title: entry.data.title,
    summary: entry.data.summary,
    href: `/projects/${entry.id}/`,
    kind: '项目',
    icon: '◇',
    detail: entry.data.status,
    date: entry.data.updated ?? entry.data.published,
    search: [entry.data.title, entry.data.summary, entry.data.status, ...entry.data.tags, entry.body].join(' ').toLowerCase(),
  })),
  ...notes.map((entry) => ({
    title: entry.data.title,
    summary: entry.data.summary,
    href: `/notes/${entry.id}/`,
    kind: '笔记',
    icon: '☘',
    detail: [entry.data.type, entry.data.series].filter(Boolean).join(' · '),
    date: entry.data.updated ?? entry.data.published,
    search: [entry.data.title, entry.data.summary, entry.data.type, entry.data.series ?? '', ...entry.data.tags, entry.body].join(' ').toLowerCase(),
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<BaseLayout title="搜索 — Boy Jiang" description="搜索博客、项目和笔记。">
  <section class="content-shell shell search-page">
    <form class="global-search" id="global-search-form" role="search">
      <input id="global-search-input" type="search" aria-label="搜索全站内容" placeholder="搜索博客、项目和笔记…" autocomplete="off" autofocus />
    </form>
    <div class="search-results" id="global-search-results" hidden>
      {items.map((item) => (
        <article class="search-result" data-search={item.search}>
          <div class="search-result-icon" aria-hidden="true">{item.icon}</div>
          <div>
            <p><span>{item.kind}</span>{item.detail && ` · ${item.detail}`}</p>
            <h2><a href={item.href}>{item.title}</a></h2>
            <div>{item.summary}</div>
          </div>
          <a class="entry-arrow" href={item.href} aria-label={`打开 ${item.title}`}>↗</a>
        </article>
      ))}
    </div>
    <div class="empty-state" id="global-search-empty" hidden>没有找到匹配内容，换个词试试。</div>
  </section>
  <script is:inline>
    const form = document.querySelector('#global-search-form');
    const input = document.querySelector('#global-search-input');
    const results = [...document.querySelectorAll('.search-result')];
    const resultsContainer = document.querySelector('#global-search-results');
    const empty = document.querySelector('#global-search-empty');

    const clearResults = () => {
      resultsContainer.hidden = true;
      empty.hidden = true;
      results.forEach((result) => { result.hidden = true; });
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim().toLowerCase();
      if (!query) {
        clearResults();
        return;
      }

      let visible = 0;
      results.forEach((result) => {
        const matches = result.dataset.search.includes(query);
        result.hidden = !matches;
        if (matches) visible += 1;
      });

      resultsContainer.hidden = visible === 0;
      empty.hidden = visible > 0;
    });

    input.addEventListener('input', clearResults);
  </script>
</BaseLayout>
