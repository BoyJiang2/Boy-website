---
export const prerender = true;
const destination = '/blogs/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>Boy Jiang</title>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destination, Astro.site ?? Astro.url)} />
  </head>
  <body><a href={destination}>前往博客</a></body>
</html>
