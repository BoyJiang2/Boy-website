---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import ProjectCard from '../components/ProjectCard.astro';

const byDate = <T extends { data: { published: Date } }>(a: T, b: T) => b.data.published.valueOf() - a.data.published.valueOf();
const blogs = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate);
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(byDate);
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);

const mantraSource = [
  { text: 'Stay unbothered.', accent: false },
  { text: 'Block the noise.', accent: false },
  { text: 'Find flow, fast.', accent: true },
];

let mantraDelay = 100;
const mantraLines = mantraSource.map((line) => {
  const characters = Array.from(line.text).map((character) => {
    const delay = mantraDelay;
    mantraDelay += 65;
    return { character, delay };
  });
  mantraDelay += 220;
  return { ...line, characters };
});
---

<BaseLayout>
  <section class="home-hero shell">
    <div>
      <p class="kicker">Hello, I am Boy Jiang</p>
      <h1 class="hero-mantra" aria-label="Stay unbothered. Block the noise. Find flow, fast.">
        {mantraLines.map((line) => (
          <span class:list={['mantra-line', line.accent && 'accent']} aria-hidden="true">
            {line.characters.map(({ character, delay }) => (
              <span class="mantra-character" style={`--character-delay: ${delay}ms;`}>{character === ' ' ? '\u00a0' : character}</span>
            ))}
          </span>
        ))}
      </h1>
      <p class="hero-lead">这是我的个人网站。我在这里记录技术笔记、项目实践，以及那些尚未成为结论的思考。</p>
      <div class="hero-links">
        <a class="pill-link primary" href="/notes/">浏览笔记 <span>→</span></a>
        <a class="pill-link" href="/blog/">阅读博客 <span>↗</span></a>
      </div>
    </div>
    <aside class="profile-note">
      <div class="profile-badge">BJ</div>
      <strong>Computer Science · Builder</strong>
      <p>正在关注大模型系统、计算机系统与值得长期使用的工具。</p>
    </aside>
  </section>

  <section class="home-section shell">
    <div class="section-head">
      <div><p class="section-kicker">Latest notes</p><h2>最近更新的笔记</h2></div>
      <a href="/notes/">查看全部 →</a>
    </div>
    <div class="entry-list">
      {notes.slice(0, 4).map((entry) => (
        <EntryRow href={`/notes/${entry.id}/`} eyebrow={entry.data.type} title={entry.data.title} summary={entry.data.summary} date={entry.data.updated ?? entry.data.published} tags={entry.data.tags} />
      ))}
    </div>
  </section>

  <section class="home-section shell">
    <div class="section-head">
      <div><p class="section-kicker">Projects</p><h2>正在做的项目</h2></div>
      <a href="/projects/">所有项目 →</a>
    </div>
    <div class="project-grid">{projects.slice(0, 2).map((entry) => <ProjectCard entry={entry} />)}</div>
  </section>

  <section class="home-section shell">
    <div class="section-head">
      <div><p class="section-kicker">Writing</p><h2>博客与所思所想</h2></div>
      <a href="/blog/">进入博客 →</a>
    </div>
    <div class="entry-list">
      {blogs.slice(0, 3).map((entry) => (
        <EntryRow href={`/blog/${entry.id}/`} eyebrow={entry.data.category} title={entry.data.title} summary={entry.data.summary} date={entry.data.published} tags={entry.data.tags} />
      ))}
    </div>
  </section>
</BaseLayout>
