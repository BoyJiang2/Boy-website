---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Boy Jiang" description="蒋博睿，中国科学院大学硕士生，聚焦 MLSys。">
  <section class="profile-home shell" id="about">
    <div class="profile-home-copy">
      <p class="page-kicker">About Me</p>
      <h1>蒋博睿 <span>Boy Jiang</span></h1>
      <p class="profile-home-role">硕士生 · 中国科学院大学上海微系统与信息技术研究所</p>
      <p class="profile-home-intro">我是来自中国科学院大学上海微系统与信息技术研究所的二年级硕士生。我的研究领域是 MLSys 和 AI infra，尤其是大模型推理与服务系统、KV Cache 中的调度和协同问题。</p>
      <p class="profile-mantra" aria-label="Emotional Insensitivity. Distraction Resistance. Rapid Flow-State Entry.">
        <span class="mantra-line" data-mantra-line aria-hidden="true">Emotional Insensitivity. Distraction Resistance.</span>
        <span class="mantra-line" data-mantra-line aria-hidden="true">Rapid Flow-State Entry.</span>
      </p>
      <div class="profile-focus" aria-label="研究方向">
        <span>MLSys</span>
        <span>LLM Inference</span>
        <span>Serving Systems</span>
      </div>
      <nav class="profile-social-links" aria-label="联系方式">
        <a href="mailto:elboy@foxmail.com">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m4.5 7 7.5 5.5L19.5 7"></path></svg>
          <span>Email</span>
        </a>
        <a href="https://scholar.google.com/citations?user=CYeGsX4AAAAJ" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9.5 12 5l9 4.5L12 14 3 9.5Z"></path><path d="M6.5 11.3V16c2.8 2.2 8.2 2.2 11 0v-4.7"></path><path d="M21 10v5"></path></svg>
          <span>Scholar</span>
        </a>
        <a href="https://github.com/BoyJiang2" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8a9.2 9.2 0 0 0-2.9 17.93c.46.09.63-.2.63-.44v-1.7c-2.58.56-3.12-1.1-3.12-1.1-.42-1.08-1.03-1.36-1.03-1.36-.84-.58.06-.57.06-.57.93.07 1.42.96 1.42.96.82 1.43 2.16 1.02 2.69.78.08-.61.32-1.02.58-1.26-2.06-.24-4.23-1.04-4.23-4.6 0-1.02.36-1.85.95-2.5-.1-.24-.41-1.18.09-2.46 0 0 .78-.25 2.53.96A8.7 8.7 0 0 1 12 6.7a8.8 8.8 0 0 1 2.3.31c1.75-1.2 2.52-.96 2.52-.96.5 1.28.19 2.22.1 2.46.59.65.94 1.48.94 2.5 0 3.57-2.17 4.35-4.24 4.59.33.29.63.87.63 1.76v2.62c0 .25.17.54.64.44A9.2 9.2 0 0 0 12 2.8Z"></path></svg>
          <span>GitHub</span>
        </a>
      </nav>
    </div>
    <figure class="profile-photo">
      <img src="/brand/borui-jiang.jpg" alt="蒋博睿" width="744" height="1028" />
    </figure>
  </section>

  <script is:inline>
    const mantraLines = [...document.querySelectorAll('[data-mantra-line]')];
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const texts = mantraLines.map((line) => line.textContent ?? '');
      mantraLines.forEach((line) => { line.textContent = ''; });
      const wait = (duration) => new Promise((resolve) => window.setTimeout(resolve, duration));

      (async () => {
        for (let index = 0; index < mantraLines.length; index += 1) {
          const line = mantraLines[index];
          line.classList.add('typing');
          for (const character of texts[index]) {
            line.textContent += character;
            await wait(35);
          }
          if (index < mantraLines.length - 1) {
            await wait(120);
            line.classList.remove('typing');
          }
        }
        await wait(1200);
        mantraLines.at(-1)?.classList.remove('typing');
      })();
    }
  </script>

  <section class="publications-section shell" id="publications">
    <div class="publication-heading">
      <p class="section-kicker">Selected Publications</p>
      <h2>科研成果</h2>
    </div>
    <ol class="publication-list">
      <li class="publication-item">
        <p class="publication-title"><a href="https://doi.org/10.1109/TIFS.2023.3309101" rel="noreferrer">A Novel Earprint: Stimulus-Frequency Otoacoustic Emission for Biometric Recognition</a></p>
        <p class="publication-authors">Yin Liu, <strong>Borui Jiang</strong>, Hongqing Liu, Yu Zhao, Fen Xiong, Yi Zhou</p>
        <p class="publication-venue">IEEE Transactions on Information Forensics and Security, vol. 18, pp. 5484–5494, 2023 · SCI 一区</p>
        <p class="publication-description">以刺激频率耳声发射（SFOAE）作为耳纹生物特征，通过多刺激强度下的频谱融合与判别建模提升身份识别的稳定性和个体可分性。</p>
        <p class="publication-links"><a href="https://doi.org/10.1109/TIFS.2023.3309101" rel="noreferrer">DOI ↗</a></p>
      </li>
      <li class="publication-item">
        <p class="publication-title"><a href="https://scholar.google.com/citations?view_op=view_citation&hl=en&user=CYeGsX4AAAAJ&citation_for_view=CYeGsX4AAAAJ:u-x6o8ySG0sC" rel="noreferrer">Ergonomic Load Differentiates Pediatric and Adult Physiotherapy</a></p>
        <p class="publication-authors">Yongji Wu, Shuang Liu, Junjie Zhang, <strong>Borui Jiang</strong>, Haitao Wang, Min Hu</p>
        <p class="publication-venue">Proceedings of the 3rd International Conference on Human Machine Interaction (ICHMI), pp. 74–80, 2023</p>
        <p class="publication-description">比较成人与儿童物理治疗中的人体工学负荷，结合惯性传感与 REBA 评估量化治疗师的姿势风险。</p>
        <p class="publication-links"><a href="https://doi.org/10.1145/3604383.3604386" rel="noreferrer">DOI ↗</a> <a href="https://scholar.google.com/citations?view_op=view_citation&hl=en&user=CYeGsX4AAAAJ&citation_for_view=CYeGsX4AAAAJ:u-x6o8ySG0sC" rel="noreferrer">Google Scholar ↗</a></p>
      </li>
    </ol>
  </section>
</BaseLayout>
