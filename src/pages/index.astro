---
import { getCollection } from 'astro:content';
import CourseCard from '../components/CourseCard.astro';
import PaperCard from '../components/PaperCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const papers = (await getCollection('papers')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Notes Atlas · 我的知识地图" description="课程、论文与思考的个人知识库。">
  <section class="hero">
    <p class="eyebrow hero-label">PERSONAL KNOWLEDGE ATLAS · 2026</p>
    <h1>把学习的轨迹，<em>做成</em><br />一张可以漫游的地图。</h1>
    <p class="hero-intro">这里记录我对计算机系统、机器学习与研究论文的持续理解。不是资料堆砌，而是问题、推导和真正值得留下的洞见。</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/courses/">进入课程笔记 <span>→</span></a>
      <a class="button button-quiet" href="/papers/">浏览论文阅读 <span>↗</span></a>
    </div>
    <div class="hero-signal" aria-hidden="true">
      <span>NOW EXPLORING</span>
      <strong>CS · ML · Systems</strong>
    </div>
  </section>

  <section class="metrics" aria-label="知识库概览">
    <div><strong>{courses.length}</strong><span>课程专题</span></div>
    <div><strong>{papers.length}</strong><span>论文卡片</span></div>
    <div><strong>∞</strong><span>待解决的问题</span></div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div><p class="eyebrow">LEARNING PATHS</p><h2>课程笔记</h2></div>
      <a href="/courses/">全部课程 →</a>
    </div>
    <div class="course-grid">
      {courses.slice(0, 3).map((entry) => <CourseCard entry={entry} />)}
    </div>
  </section>

  <section class="section-block paper-section">
    <div class="section-heading">
      <div><p class="eyebrow">PAPER TRAIL</p><h2>论文阅读</h2></div>
      <a href="/papers/">所有论文 →</a>
    </div>
    <div class="paper-grid">
      {papers.slice(0, 2).map((entry) => <PaperCard entry={entry} />)}
    </div>
  </section>

  <section class="about-panel" id="about">
    <p class="eyebrow">ABOUT THIS ATLAS</p>
    <div>
      <h2>给未来的自己，也给偶然到访的你。</h2>
      <p>把这里替换成你的个人简介：研究兴趣、正在做的事、项目链接或邮箱。网站内容全部由 Markdown 驱动，写一篇笔记就像在 Obsidian 里新增一个文件。</p>
    </div>
  </section>
</BaseLayout>
