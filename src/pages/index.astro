---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getNoteLocation } from '../utils/notes';

const byTitle = <T extends { data: { title: string } }>(a: T, b: T) => a.data.title.localeCompare(b.data.title, 'zh-CN');
const blogs = (await getCollection('blog')).sort(byTitle);
const notes = (await getCollection('notes')).sort((a, b) => a.id.localeCompare(b.id, 'zh-CN'));
const projects = (await getCollection('projects')).sort(byTitle);
---

<BaseLayout>
  <section class="home-hero shell">
    <div>
      <p class="kicker">Hello, I am Boy Jiang</p>
      <h1 class="hero-mantra" aria-label="Emotional Insensitivity，钝感力。Distraction Resistance，屏蔽力。Rapid Flow-State Entry，快速心流。">
        <span class="mantra-line" data-mantra-line aria-hidden="true">Emotional Insensitivity · 钝感力</span>
        <span class="mantra-line" data-mantra-line aria-hidden="true">Distraction Resistance · 屏蔽力</span>
        <span class="mantra-line" data-mantra-line aria-hidden="true">Rapid Flow-State Entry · 快速心流</span>
      </h1>
      <p class="hero-lead">记录技术、实践，以及尚未定型的思考。</p>
      <div class="hero-links">
        <a class="pill-link primary" href="/notes/">浏览笔记 <span>→</span></a>
        <a class="pill-link" href="/blog/">阅读博客 <span>↗</span></a>
      </div>
    </div>
  </section>

  <script is:inline>
    const mantraLines = [...document.querySelectorAll('[data-mantra-line]')];
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const texts = mantraLines.map((line) => line.textContent ?? '');
      mantraLines.forEach((line) => { line.textContent = ''; });
      const wait = (duration) => new Promise((resolve) => window.setTimeout(resolve, duration));

      (async () => {
        for (let index = 0; index < mantraLines.length; index += 1) {
          const line = mantraLines[index];
          line.classList.add('typing');
          for (const character of texts[index]) {
            line.textContent += character;
            await wait(45);
          }
          if (index < mantraLines.length - 1) {
            await wait(120);
            line.classList.remove('typing');
          }
        }
        await wait(1200);
        mantraLines.at(-1)?.classList.remove('typing');
      })();
    }
  </script>

  <section class="home-section shell">
    <div class="section-head">
      <div><p class="section-kicker">Blogs</p><h2>博客</h2></div>
      <a href="/blog/">查看全部 →</a>
    </div>
    <div class="entry-list">
      {blogs.slice(0, 3).map((entry) => (
        <EntryRow href={`/blog/${entry.id}/`} title={entry.data.title} summary={entry.data.summary} tags={entry.data.tags} />
      ))}
    </div>
  </section>

  <section class="home-section shell">
    <div class="section-head">
      <div><p class="section-kicker">Notes</p><h2>笔记</h2></div>
      <a href="/notes/">查看全部 →</a>
    </div>
    <div class="entry-list">
      {notes.slice(0, 4).map((entry) => {
        const location = getNoteLocation(entry);
        return <EntryRow href={`/notes/${location.slug}/`} eyebrow={`${location.category} · ${location.series}`} title={entry.data.title} summary={entry.data.summary} tags={entry.data.tags} />;
      })}
    </div>
  </section>

  <section class="home-section shell">
    <div class="section-head">
      <div><p class="section-kicker">Projects</p><h2>项目</h2></div>
      <a href="/projects/">查看全部 →</a>
    </div>
    <div class="project-grid">{projects.slice(0, 2).map((entry, index) => <ProjectCard entry={entry} index={index} />)}</div>
  </section>
</BaseLayout>
